# Local Cloudflare Worker secrets (copy to .dev.vars — never commit)
#
#   cp .dev.vars.example .dev.vars
#
# Must match TRAINING_JWT_SECRET in apps-script/Code.gs
TRAINING_JWT_SECRET=your-local-dev-secret-here

