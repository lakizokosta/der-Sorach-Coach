{
  "name": "der-sprachcoach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Der SprachCoach — a Vue 3 rebuild of the German language learning trainer.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "questions:verify": "node scripts/verify-questions.mjs",
    "questions:audit-reflexiv": "node scripts/audit-reflexiv-hints.mjs",
    "questions:audit-genitiv": "node scripts/audit-genitiv-questions.mjs",
    "questions:audit-possessiv": "node scripts/audit-possessiv-hints.mjs",
    "questions:fix-possessiv": "node scripts/generate-a1-select-one.mjs --restore --topic=POSSESSIVARTIKEL && node scripts/generate-a2-select-one.mjs --restore --topic=POSSESSIVARTIKELA2",
    "questions:export-review": "node scripts/export-manual-review.mjs",
    "questions:fix-verbkonj-a1": "node scripts/fix-a1-verbkonjugation.mjs",
    "questions:fix-adj-a1": "node scripts/fix-a1-adjektivdeklination.mjs",
    "questions:fix-dat-a1": "node scripts/fix-a1-dativa1.mjs",
    "questions:fix-genitiv": "node scripts/fix-genitiv-questions.mjs",
    "questions:stats": "node scripts/question-stats.mjs",
    "questions:generate-a1": "node scripts/generate-a1-select-one.mjs",
    "questions:generate-a2": "node scripts/generate-a2-select-one.mjs",
    "questions:generate-a2-input": "node scripts/generate-a2-input-text.mjs",
    "questions:generate-a2-dropbox": "node scripts/generate-a2-dropbox.mjs",
    "questions:generate-b1": "node scripts/generate-b1-select-one.mjs",
    "questions:generate-b1-input": "node scripts/generate-b1-input-text.mjs",
    "questions:generate-b1-dropbox": "node scripts/generate-b1-dropbox.mjs",
    "questions:generate-b1-sprach-exam": "node scripts/generate-b1-sprachbausteine-exam.mjs",
    "questions:generate-b2": "node scripts/generate-b2-select-one.mjs",
    "questions:generate-b2-input": "node scripts/generate-b2-input-text.mjs",
    "questions:generate-b2-dropbox": "node scripts/generate-b2-dropbox.mjs",
    "questions:generate-b2-sprach-exam": "node scripts/generate-b2-sprachbausteine-exam.mjs",
    "questions:audit-sprach": "node scripts/audit-sprachbausteine.mjs",
    "questions:audit": "node scripts/audit-question-bank.mjs",
    "questions:fix-input-hints": "node scripts/fix-input-text-hints.mjs",
    "questions:generate-a1-input": "node scripts/generate-a1-input-text.mjs",
    "questions:generate-a1-dropbox": "node scripts/generate-a1-dropbox.mjs",
    "questions:rebuild-dropbox": "node scripts/rebuild-dropbox-banks.mjs",
    "questions:restore-dropbox": "node scripts/restore-all-dropbox.mjs",
    "questions:audit-dropbox": "node scripts/audit-dropbox-sentences.mjs",
    "backend:verify": "node scripts/verify-backend.mjs",
    "backend:check": "node scripts/check-backend-url.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "wrangler": "^4.98.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
